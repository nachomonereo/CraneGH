<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Title>CraneGH</Title>
    <Description>Discrete Differential Geometry (DDG) Mesh Toolkit for Grasshopper based on Keenan Crane's Research</Description>
    <TargetExt>.gha</TargetExt>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="7.13.21348.13001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
